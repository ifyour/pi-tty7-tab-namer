		"README.md"
	],
	"keywords": [
		"pi-package",
		"pi",
		"tty7",
		"terminal",
		"tab-title",
		"session-name"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ifyour/pi-tty7-tab-namer.git"
	},
	"pi": {
